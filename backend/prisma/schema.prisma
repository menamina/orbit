generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                      Int                @id @default(autoincrement())
  name                    String
  username                String             @unique
  email                   String             @unique
  settings                Settings?
  cycleTracking           CycleTracking[]
  packs                PillPack[]
  notes                   Notes[]

  accounts                Account[]          // Multiple OAuth providers support
  refreshTokens           RefreshToken[]

  @@index([id])
  @@index([username])
  @@index([email])
}

model Account {
  id                      Int                @id @default(autoincrement())
  userID                  Int
  provider                String             // "github", "google", "local", etc.
  providerId              String             // OAuth provider's user ID (or email for local auth)
  createdAt               DateTime           @default(now())

  user                    User               @relation(fields: [userID], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
  @@index([userID])
}

model RefreshToken {
  id                      Int                @id @default(autoincrement())
  token                   String             @unique
  userID                  Int
  expiresAt               DateTime
  createdAt               DateTime           @default(now())

  user                    User               @relation(fields: [userID], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userID])
}

model Settings {
  id                      Int                @id @default(autoincrement())
  userID                  Int                @unique
  icon                    String
  appColor                String
  saltedHash              String?            // Optional - GitHub/OAuth users won't have password
  cycleLength             Int?
  daysBetweenPeriod       Int?
  ovulationPrediction     Int?

  user                    User               @relation(fields: [userID], references: [id], onDelete: Cascade)
  @@index([userID])
}


model CycleTracking {
  id                      Int                @id @default(autoincrement())
  userID                  Int
  startDate               DateTime
  estimateEndDate         DateTime?
  endDate                 DateTime?

  user                    User               @relation(fields: [userID], references: [id], onDelete: Cascade)

  @@index([userID, startDate])
  @@index([userID])
}

model PillPack {
  id                      Int                @id @default(autoincrement())
  userID                  Int
  packNumber        Int                
  startDate         DateTime         
  endDate           DateTime?        
  isComplete        Boolean          @default(false)
  
  pills             PillTracking[]   // Pills in this pack
  user              User             @relation(fields: [userID], references: [id])
  
  @@unique([userID, id, packNumber])     
  @@index([userID, startDate])
}

model PillTracking {
  id                Int              @id @default(autoincrement())
  pillPackID        Int
  dayNumber         Int
  date              DateTime         // When they actually took it

  blisterPack       PillPack      @relation(fields: [pillPackID], references: [id], onDelete: Cascade)

  @@unique([pillPackID, dayNumber])
  @@index([pillPackID, date])
  @@index([pillPackID])
}

model Notes {
  id                      Int                @id @default(autoincrement())
  userID                  Int
  date                    DateTime           @default(now())
  note                    String

  user                    User               @relation(fields: [userID], references: [id], onDelete: Cascade)
  @@index([userID, date])
}

