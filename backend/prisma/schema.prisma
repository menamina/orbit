generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                      Int                @id @default(autoincrement())
  name                    String
  username                String             @unique
  email                   String             @unique
  settings                Settings?
  cycleDays               CycleDay[]
  packs                   PillPack[]
  notes                   Notes[]

  accounts                Account[]          // Multiple OAuth providers support
  refreshTokens           RefreshToken[]

  @@index([id])
  @@index([username])
  @@index([email])
}

model Account {
  id                      Int                @id @default(autoincrement())
  userID                  Int
  provider                String             // "github", "google", "local", etc.
  providerId              String             // OAuth provider's user ID (or email for local auth)
  createdAt               DateTime           @default(now())

  user                    User               @relation(fields: [userID], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
  @@index([userID])
}

model RefreshToken {
  id                      Int                @id @default(autoincrement())
  token                   String             @unique
  userID                  Int
  expiresAt               DateTime
  createdAt               DateTime           @default(now())

  user                    User               @relation(fields: [userID], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userID])
}

model Settings {
  id                      Int                @id @default(autoincrement())
  userID                  Int                @unique
  icon                    String             @default("cheesecake")
  saltedHash              String?            // Optional - GitHub/OAuth users won't have password
  cycleLength             Int                @default(0)
  daysBetweenPeriod       Int                @default(0)
  ovulationPrediction     Int                @default(0)

  user                    User               @relation(fields: [userID], references: [id], onDelete: Cascade)
  @@index([userID])
}


model CycleDay {
  id                      Int                @id @default(autoincrement())
  userID                  Int
  date                    DateTime            @db.Date


  user                    User               @relation(fields: [userID], references: [id], onDelete: Cascade)
  
  @@index([userID, id])
  @@index([userID, date])
}

model PillPack {
  id                Int                @id @default(autoincrement())
  userID            Int
  packNumber        Int
  startDate         DateTime           @db.Date
  endDate           DateTime?          @db.Date
  isComplete        Boolean          @default(false)
  startDayOfWeek    String           @default("sun")

  pills             PillTracking[]   // Pills in this pack
  user              User             @relation(fields: [userID], references: [id])

  @@unique([userID, id, packNumber])
  @@index([userID, startDate])
}

model PillTracking {
  id                Int              @id @default(autoincrement())
  pillPackID        Int
  dayNumber         Int
  date              DateTime         @db.Date  // When they actually took it

  blisterPack       PillPack      @relation(fields: [pillPackID], references: [id], onDelete: Cascade)

  @@unique([pillPackID, dayNumber])
  @@index([pillPackID, date])
  @@index([pillPackID])
}

model Notes {
  id                      Int                @id @default(autoincrement())
  userID                  Int
  date                    DateTime           @db.Date  @default(now())
  note                    String

  user                    User               @relation(fields: [userID], references: [id], onDelete: Cascade)
  @@index([userID, date])
}

